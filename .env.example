DATABASE_URL="mysql://kolvia:YOUR_PASSWORD@127.0.0.1:3306/kolvia"
# Optional MySQL test connection with permission to create/drop test databases.
TEST_DATABASE_URL=""
APP_URL="http://127.0.0.1:3000"
# Gemini through the configured chat-completions gateway. All variables are server-only.
API_KEY_AI=""
AI_CHAT_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
# Keep the exact model identifier supported by your gateway.
AI_MODEL="gemini-3-flash"
# Token from UploadThing Dashboard. Server only; never use NEXT_PUBLIC_ prefix.
UPLOADTHING_TOKEN=""
# Pusher Channels. App secret stays on the server; key/cluster are passed to the browser.
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_APP_CLUSTER=""
# Set these yourself before running db:seed. Passwords must be at least 10 characters.
DEMO_ADMIN_EMAIL="admin@kolvia.local"
DEMO_ADMIN_PASSWORD=""
DEMO_KOL_EMAIL="linh@kolvia.local"
DEMO_KOL_PASSWORD=""
DEMO_ORGANIZER_EMAIL="organizer@kolvia.local"
DEMO_ORGANIZER_PASSWORD=""
