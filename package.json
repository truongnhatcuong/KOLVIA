{
  "name": "kolvia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "prestart": "npm run db:check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:admin": "node --env-file=.env --import tsx scripts/demo-admin.ts",
    "profile:complete": "node --env-file=.env --import tsx scripts/complete-profile.ts",
    "media:cleanup": "node --env-file=.env --import tsx scripts/cleanup-media.ts",
    "setup": "node scripts/setup.mjs",
    "test": "node scripts/test.mjs",
    "test:api": "npm run build && node scripts/test.mjs tests/routes.test.mjs",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "test:unit": "node --import tsx --test tests/database-config.test.mjs tests/test-database.test.mjs tests/prisma-client.test.mjs tests/profile-ui.test.tsx tests/social-embeds.test.tsx tests/realtime.test.ts tests/withdrawal-policy.test.ts tests/withdrawal-services.test.ts tests/request-origin.test.ts tests/validation.test.ts tests/password-change.test.ts tests/ai.test.ts tests/chat-ui.test.tsx"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "1.2.3",
    "@uploadthing/react": "7.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "uploadthing": "7.7.4",
    "zod": "4.6.5"
  },
  "overrides": {
    "@effect/platform@0.90.3": {
      "effect": "3.17.7"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "playwright": "1.63.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
